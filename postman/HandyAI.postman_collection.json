{
  "info": {
    "name": "HandyAI API",
    "description": "Every HandyAI endpoint, grouped like the Swagger UI tags.\n\n1. Start the backend (`mvnw spring-boot:run` or `docker compose up`).\n2. Run **Auth > Login** (the local demo account) or **Register**: the token is saved to the `token` collection variable and sent as a Bearer header on every request.\n3. The Admin folder needs the admin account's token (set HANDYAI_ADMIN_PASSWORD).\n\nChange `baseUrl` to the deployed API to try production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "toolSlug",
      "value": "descript"
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ],
